    <string name="new_phone_show">Move to a new phone</string>
    <string name="new_phone_hide">Hide steps</string>
    <string name="new_phone_intro">Your documents move with a backup file. This works with or without an account.</string>
    <string name="new_phone_step_1">On this phone: tap Export backup and wait for “Backup saved and verified”.</string>
    <string name="new_phone_step_2">Move the ZIP file to the new phone (cloud drive, USB cable or nearby sharing).</string>
    <string name="new_phone_step_3">Install Paperly on the new phone and open Settings.</string>
    <string name="new_phone_step_4">Tap Check a backup file and pick the ZIP. It should say the backup is healthy.</string>
    <string name="new_phone_step_5">Tap Restore from backup, pick the ZIP, review the summary and confirm.</string>
    <string name="new_phone_step_6">Optional: sign in on the new phone if you also use cloud sync.</string>
    <string name="new_phone_note">Keep the backup file until you have checked that everything is on the new phone.</string>
</resources>
