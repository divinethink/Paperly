    <string name="settings_privacy_header">Privacy and your data</string>
    <string name="settings_privacy_export">Export my data</string>
    <string name="settings_privacy_export_hint">Saves one ZIP file with everything on this phone: documents, folders, reading progress, bookmarks, annotations and scan notes. It is the same file as Export backup; the result is shown under Backup above.</string>
    <string name="settings_privacy_show">What leaves this phone?</string>
    <string name="settings_privacy_hide">Hide details</string>
    <string name="settings_privacy_intro">Paperly works fully offline. Nothing below is sent anywhere unless it says so.</string>
    <string name="settings_privacy_signout_note">Signing out does not delete what is already in the cloud.</string>
    <string name="privacy_local_title">Stays on this phone</string>
    <string name="privacy_local_when">Always</string>
    <string name="privacy_local_body">Your document files, reading position, bookmarks, annotations and scan page notes. Bookmarks, annotations and scan notes are never sent to the cloud.</string>
    <string name="privacy_auth_title">Google sign-in (Firebase Authentication)</string>
    <string name="privacy_auth_when">Only if you sign in</string>
    <string name="privacy_auth_body">Your Google account email and an account ID, so that your cloud copy belongs only to you.</string>
    <string name="privacy_firestore_title">Cloud Firestore</string>
    <string name="privacy_firestore_when">Only if you sign in and sync</string>
    <string name="privacy_firestore_body">Document details: title, type, size, a content fingerprint (SHA-256), folder, tags, favourite, dates and reading position. Not the file contents.</string>
    <string name="privacy_drive_title">Google Drive (hidden app folder)</string>
    <string name="privacy_drive_when">Only if you allow file sync</string>
    <string name="privacy_drive_body">A copy of each document file, kept in a hidden folder that only Paperly can see. Paperly asks for the drive.appdata permission only, so it cannot see your other Drive files.</string>
    <string name="privacy_crash_title">Crash reports (Firebase Crashlytics)</string>
    <string name="privacy_crash_when">When the app crashes, in builds that include Firebase</string>
    <string name="privacy_crash_body">Technical crash details and basic device information (model, Android version). Paperly adds no document titles or contents to them.</string>
    <string name="privacy_scan_title">Document scanner (Google Play services)</string>
    <string name="privacy_scan_when">Only when you scan</string>
    <string name="privacy_scan_body">Scanning runs on your phone. Paperly does not send scanned pages anywhere on its own.</string>
